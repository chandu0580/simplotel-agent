  {
    "id": "availability-missing-dates",
    "category": "Missing information",
    "turns": [
      "Do you have rooms available?"
    ],
    "expect": {
      "types": [
        "collect_booking_details"
      ]
    }
  },
  {
    "id": "availability-explicit",
    "category": "Availability / tool call",
    "turns": [
      "Do you have rooms from {wed} to {fri} for 2 adults?"
    ],
    "expect": {
      "types": [
        "availability"
      ],
      "availability": {
        "available": true,
        "nights": 2,
        "adults": 2
      }
    }
  },
  {
    "id": "availability-relative-dates",
    "category": "Availability / tool call",
    "ai_only": true,
    "turns": [
      "Any rooms for 2 adults checking in on {wed_human} for two nights?"
    ],
    "expect": {
      "types": [
        "availability"
      ],
      "availability": {
        "nights": 2,
        "adults": 2,
        "check_in": "{wed}"
      }
    }
  },
  {
    "id": "availability-sold-out",
    "category": "Availability / tool call",
    "turns": [
      "Is a room available from {sat} to {sun} for 4 adults and 1 child?"
    ],
    "expect": {
      "types": [
        "availability"
      ],
      "availability": {
        "available": false
      }
    }
  },
  {
    "id": "availability-past-date",
