# Copy to backend/.env. Never commit the real file.

# Required for AI mode. Without it the backend runs in deterministic offline (FAQ) mode.
ANTHROPIC_API_KEY=

# Optional
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low          # low | medium | high
ANTHROPIC_REFUSAL_FALLBACK=default   # default | none (server-side re-run on another model if Claude declines)
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
AI_ENABLED=true               # set false to force offline mode
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

