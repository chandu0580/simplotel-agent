# Copy to backend/.env for local development. Never commit the real file.
# Every setting is optional; defaults are in app/core/config.py. Full reference: docs/CONFIGURATION.md.
# Keep comments on their own lines: dotenv treats a comment after an empty value as the value.

# ----- Environment -----
# development | test | production (production enforces HTTPS model endpoints, safe CORS, JSON logs, rate limits, no dev auth)
APP_ENV=development

# ----- LLM -----
# glm (default runtime provider, OpenAI-compatible protocol) | anthropic | mock (load tests; rejected in production) | none
LLM_PROVIDER=glm
# Global kill switch for AI answers. Without a configured provider the assistant runs in offline (FAQ) mode.
AI_ENABLED=true
# glm: API key and base URL of the OpenAI-compatible endpoint (for example https://gateway.example/v1).
# Production requires https://.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-5.2
# Optional model for future routed tasks; empty means LLM_MODEL.
LLM_MODEL_FAST=
# anthropic: used only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_FAST=
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
# default | none
ANTHROPIC_REFUSAL_FALLBACK=default
# mock: simulated model latency for load tests.
MOCK_LLM_LATENCY_MS=1500
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=16000

# ----- HTTP -----
# Threads for request handlers. Guest turns mostly wait on the model, so this caps concurrent AI turns per process.
WORKER_THREADS=150
# Comma-separated allow-list; only needed when the UI is served from another origin.
CORS_ORIGINS=http://localhost:5173
# true only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Empty means: true outside production, false in production.
EXPOSE_API_DOCS=

# ----- Telemetry -----
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# /metrics must not be exposed publicly.
METRICS_ENABLED=true

# ----- Shared state and database -----
# memory (one process) | redis (several replicas: conversations, rate limits, idempotency, locks)
STATE_BACKEND=memory
# Required when STATE_BACKEND=redis. redis://, rediss:// or unix://
REDIS_URL=
REDIS_KEY_PREFIX=sa
# Optional PostgreSQL for the audit trail. Connect as a non-superuser role so row-level security applies.
DATABASE_URL=
AUDIT_RETENTION_DAYS=365

# ----- Admin API auth -----
# disabled | static_token (development only; rejected in production)
AUTH_MODE=disabled
# static_token only: <token>=<tenant|*>:<role>[|role][:<hotel>[|hotel]],...
ADMIN_API_TOKENS=

# ----- Rate limits -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_IP_BURST=30
RATE_LIMIT_BURST_WINDOW_SECONDS=10
RATE_LIMIT_CONVERSATION_PER_MINUTE=20
RATE_LIMIT_HOTEL_PER_MINUTE=1200
RATE_LIMIT_TENANT_PER_MINUTE=3000

# ----- Caching -----
KNOWLEDGE_CACHE_TTL_SECONDS=300
# 0 disables availability caching.
AVAILABILITY_CACHE_TTL_SECONDS=15

# ----- Conversations and privacy -----
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_MESSAGES=40
CONVERSATION_CONTEXT_WINDOW=12
CONVERSATION_MAX_ACTIVE=50000
CONVERSATION_LOCK_WAIT_SECONDS=30
# Must exceed LLM_TIMEOUT_SECONDS x (LLM_MAX_RETRIES + 1).
CONVERSATION_LOCK_LEASE_SECONDS=120
# Mask emails and phone numbers in guest messages (card numbers are always masked).
PII_MASK_CONTACT_DETAILS=true

# ----- Reservation integration resilience -----
RESERVATION_TIMEOUT_SECONDS=5
RESERVATION_READ_RETRIES=2
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# ----- Feature flags (global defaults; tenants can override in app/data/tenants.json) -----
# FEATURE_AI_ASSISTANT_ENABLED=true
# FEATURE_BOOKING_TOOLS_ENABLED=false
# FEATURE_GUARDRAIL_PRICE_CHECK_ENABLED=true
# Not implemented in this build; enabling it fails startup:
# FEATURE_SEMANTIC_RETRIEVAL_ENABLED=false
# FEATURE_WHATSAPP_ENABLED=false
# FEATURE_VOICE_ENABLED=false
